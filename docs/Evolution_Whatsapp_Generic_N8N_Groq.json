    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\nconst data = body.data || {};\nconst key = data.key || {};\nconst message = data.message || {};\nconst instanceName = body.instance || body.instanceName || body.instance_name || input.instanceName;\nconst remoteJid = key.remoteJid || data.remoteJid || data.sender || '';\nconst messageType = data.messageType || data.message_type || (message.audioMessage ? 'audioMessage' : 'conversation');\nconst fromMe = key.fromMe === true;\nconst event = body.event || '';\nconst validEvent = !event || event === 'messages.upsert' || event === 'MESSAGES_UPSERT';\nif (!validEvent || fromMe || !instanceName || !remoteJid || remoteJid.includes('@g.us') || remoteJid === 'status@broadcast') return [];\nconst userMessage = message.conversation || message.extendedTextMessage?.text || data.message?.conversation || data.text || '';\nconst customerPhone = String(remoteJid).split('@')[0].replace(/\\D/g, '');\nreturn [{ json: { ...input, body, event, instanceName, remoteJid, customerPhone, customerName: data.pushName || data.pushname || body.senderName || null, messageId: key.id || data.id || null, messageType, userMessage, hasAudio: messageType === 'audioMessage', rawMessage: message, receivedAt: new Date().toISOString() } }];"
      },
      "id": "9b57f48d-73d8-4f3e-9ca7-5ab2f3060003",
      "name": "Normalize Incoming Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -740,
        80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "audio-check",
              "leftValue": "={{ $json.hasAudio }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9b57f48d-73d8-4f3e-9ca7-5ab2f3060004",
      "name": "Is Audio?",
