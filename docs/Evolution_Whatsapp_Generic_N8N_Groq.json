    {
      "parameters": {
        "jsCode": "const original = $('Normalize Incoming Message').first().json;\nconst transcript = $input.first().json.text || $input.first().json.transcription || '';\nreturn [{ json: { ...original, userMessage: transcript, transcription: transcript, messageType: 'audioMessage' } }];"
      },
      "id": "9b57f48d-73d8-4f3e-9ca7-5ab2f3060008",
