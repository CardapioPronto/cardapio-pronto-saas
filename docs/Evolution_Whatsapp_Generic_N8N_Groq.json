    {
      "parameters": {
        "jsCode": "const base = $('Load Context and Persist Incoming').first().json;\nconst raw = $input.first().json.output || $input.first().json.text || '';\nlet parsed;\ntry { parsed = JSON.parse(String(raw).replace(/^```json\\s*/i, '').replace(/```$/i, '').trim()); } catch { parsed = { action: 'reply', message: String(raw), confidence: 0.7, handoff_reason: null, order_draft: null }; }\nconst outboundText = parsed.message || 'Desculpe, nao consegui gerar uma resposta agora. Vou encaminhar para um atendente.';\nreturn [{ json: { ...base, aiRawOutput: raw, aiResult: parsed, action: parsed.action || 'reply', outboundText, confidence: Number(parsed.confidence ?? 0.7), handoffReason: parsed.handoff_reason || null } }];"
      },
      "id": "9b57f48d-73d8-4f3e-9ca7-5ab2f3060015",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nif (!item.outboundText) return [];\nreturn [{ json: item }];"
      },
      "id": "9b57f48d-73d8-4f3e-9ca7-5ab2f3060016",
      "name": "Prepare Direct Response",
      "type": "n8n-nodes-base.code",
