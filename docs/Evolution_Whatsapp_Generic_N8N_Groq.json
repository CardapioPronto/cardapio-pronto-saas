        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { base64: $json.audioBase64, mimeType: $json.audioMimeType, fileName: $json.audioFileName, language: \"pt\" } }}",
        "options": {}
      },
      "id": "9b57f48d-73d8-4f3e-9ca7-5ab2f3060007",
      "name": "Transcribe Audio",
