        "url": "={{ $json.supabaseUrl }}/functions/v1/whatsapp-n8n-evolution",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $env.N8N_INTERNAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { action: 'decode_media', instanceName: $json.instanceName, messageId: $json.messageId, remoteJid: $json.remoteJid, messageKey: { id: $json.messageId, remoteJid: $json.remoteJid, fromMe: false } } }}",
        "options": {}
      },
      "id": "9b57f48d-73d8-4f3e-9ca7-5ab2f3060005",
      "name": "Decode Audio Media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -300,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const original = $('Normalize Incoming Message').first().json;\nconst payload = $input.first().json;\nconst base64 = payload.base64 || payload.data || payload.file || payload.media || '';\nconst mimeType = payload.mimetype || payload.mimeType || 'audio/ogg';\nif (!base64) return [{ json: { ...original, userMessage: '', audioError: 'Audio sem base64 retornado pela Evolution API' } }];\nreturn [{ json: { ...original, audioBase64: base64, audioMimeType: mimeType, audioFileName: 'audio.ogg' } }];"
      },
      "id": "9b57f48d-73d8-4f3e-9ca7-5ab2f3060006",
      "name": "Prepare Groq Audio Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        -80
      ]
    },
    {
