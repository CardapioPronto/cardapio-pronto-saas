      "parameters": {
        "jsCode": "const item = $input.first().json;\nif (!item.outboundText) return [];\nreturn [{ json: { ...item, outboundText: String(item.outboundText).slice(0, 3500) } }];"
      },
      "id": "9b57f48d-73d8-4f3e-9ca7-5ab2f3060017",
      "name": "Prepare Outbound Message",
      "type": "n8n-nodes-base.code",
