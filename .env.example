
# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Front-end observability
# Optional in Lovable: the public DSN also has a code fallback in src/lib/observability.ts.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=pubfy@0.0.1
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_APP_VERSION=0.0.1

# Supabase Edge Function secrets
# Configure com `supabase secrets set OWNER_SIGNUP_CLEANUP_SECRET=...`
OWNER_SIGNUP_CLEANUP_SECRET=change-me-to-a-long-random-secret
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=pubfy@0.0.1
SENTRY_SAMPLE_RATE=1

# WhatsApp Integration via UltraMsg
# Cada restaurante agora configura suas próprias credenciais na tela de integração
# Não é mais necessário configurar variáveis globais ULTRAMSG_INSTANCE_ID e ULTRAMSG_TOKEN

# Exemplo de configuração anterior (não mais necessário):
# VITE_ULTRAMSG_INSTANCE_ID=instance123456
# VITE_ULTRAMSG_TOKEN=ultramsg_token_here

# Para configurar WhatsApp:
# 1. Acesse https://app.ultramsg.com/
# 2. Crie sua conta e instância
# 3. Configure na tela de integrações do sistema
