
# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# WhatsApp Integration via UltraMsg
# Cada restaurante agora configura suas próprias credenciais na tela de integração
# Não é mais necessário configurar variáveis globais ULTRAMSG_INSTANCE_ID e ULTRAMSG_TOKEN

# Exemplo de configuração anterior (não mais necessário):
# VITE_ULTRAMSG_INSTANCE_ID=instance123456
# VITE_ULTRAMSG_TOKEN=ultramsg_token_here

# Para configurar WhatsApp:
# 1. Acesse https://app.ultramsg.com/
# 2. Crie sua conta e instância
# 3. Configure na tela de integrações do sistema
