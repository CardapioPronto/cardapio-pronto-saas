# =====================================================================
# Pubfy — Variáveis de ambiente
# ---------------------------------------------------------------------
# Este arquivo NUNCA é commitado com valores reais. Ele lista todas as
# variáveis usadas pelo frontend (Vite/Lovable) e pelas Supabase Edge
# Functions. Onde configurar cada uma:
#
#   1. VITE_*           -> Lovable Project Settings > Environment
#                          (são as únicas que o bundle Vite enxerga)
#   2. Demais secrets    -> Supabase Dashboard > Project Settings >
#                          Edge Functions > Secrets, ou via CLI:
#                          `supabase secrets set NOME=valor`
#   3. Auth URLs         -> Supabase Dashboard > Authentication >
#                          URL Configuration (não vivem em arquivo)
#
# Há um script `npm run preflight:prod` que valida boa parte deste setup.
# =====================================================================

# ---------------------------------------------------------------------
# Frontend (Lovable env / Vite)
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Observabilidade do frontend. Em Lovable, o publicSentryDsn fica
# embutido no código como fallback; estas variáveis sobrescrevem em prod.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=pubfy@0.0.1
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_APP_VERSION=0.0.1

# ---------------------------------------------------------------------
# Supabase Edge Functions — secrets gerais
# Configure no Dashboard (Project Settings > Edge Functions > Secrets)
# ou via CLI `supabase secrets set NOME=valor`.
# ---------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública canônica do produto (sem barra no final). Usada em e-mails
# transacionais (link de acompanhamento do pedido) e mensagens WhatsApp.
PUBLIC_SITE_URL=https://your-production-domain.com
SITE_URL=https://your-production-domain.com

# Secret para a Edge `cleanup-unverified-owner-signups` (chamada por cron).
OWNER_SIGNUP_CLEANUP_SECRET=change-me-to-a-long-random-secret

# Observabilidade Edge — DSN do Sentry é o mesmo project, secret name
# diferente porque Edge Functions não enxergam VITE_*.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=pubfy@0.0.1
SENTRY_SAMPLE_RATE=1
ENVIRONMENT=production

# ---------------------------------------------------------------------
# Pagar.me (assinaturas + pagamento online)
# ---------------------------------------------------------------------
PAGARME_SECRET_KEY=
PAGARME_WEBHOOK_SECRET=
PAGARME_PLATFORM_RECIPIENT_ID=

# ---------------------------------------------------------------------
# Resend (e-mail transacional/campanha)
# ---------------------------------------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_NAME=Pubfy
RESEND_FROM_EMAIL=contato@mail.pubfy.com.br
RESEND_REPLY_TO=contato@pubfy.com.br

# ---------------------------------------------------------------------
# WhatsApp / n8n / IA
# ---------------------------------------------------------------------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
N8N_WEBHOOK_URL=
N8N_INTERNAL_API_KEY=change-me-to-a-long-random-secret
GROQ_API_KEY=
OPENAI_API_KEY=
LOVABLE_API_KEY=

# ---------------------------------------------------------------------
# Auth (configurado no Dashboard, listado aqui para referência)
# ---------------------------------------------------------------------
# Supabase Dashboard > Authentication > URL Configuration:
#   - Site URL:            https://your-production-domain.com
#   - Redirect URLs:       https://your-production-domain.com/**
#                           https://staging-domain.com/**
# Sem isso, links de confirmação/reset abrem em localhost em produção.

# ---------------------------------------------------------------------
# WhatsApp Integration via UltraMsg (legado — substituído por Evolution)
# ---------------------------------------------------------------------
# Cada restaurante hoje configura suas credenciais na tela de integração.
# Mantido aqui apenas como referência histórica.
# VITE_ULTRAMSG_INSTANCE_ID=
# VITE_ULTRAMSG_TOKEN=
